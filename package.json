{
	"name": "@melkizedekict/superswarm",
	"version": "0.1.0-alpha.3",
	"description": "Superswarm — multi-agent coding orchestration based on Overstory by Jaymin West.",
	"author": "Jaymin West",
	"contributors": [
		"MelkiZedekICT"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/MelkiZedekICT/superswarm-v.1melki.git"
	},
	"homepage": "https://github.com/MelkiZedekICT/superswarm-v.1melki",
	"keywords": [
		"ai",
		"agents",
		"orchestration",
		"claude-code",
		"multi-agent",
		"swarm",
		"cli",
		"developer-tools"
	],
	"bin": {
		"superswarm": "./src/index.ts",
		"overstory": "./src/index.ts",
		"ov": "./src/index.ts"
	},
	"main": "src/index.ts",
	"files": [
		"bin",
		"src",
		"agents",
		"templates",
		"ui/dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"version:bump": "bun scripts/version-bump.ts",
		"build:ui": "cd ui && bun install && bun run build",
		"prepack": "node scripts/verify-package.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@os-eco/canopy-cli": "0.2.6",
		"@os-eco/mulch-cli": "^0.6.2",
		"@os-eco/seeds-cli": "0.5.15",
		"chalk": "^6.0.0",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"@types/bun": "latest",
		"@types/js-yaml": "^4.0.9",
		"typescript": "^5.9.0"
	}
}
